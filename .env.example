# ===== Glass Pro Suite - konfigurasi =====
# Salin ke .env (lokal) atau isi di Coolify > Environment Variables (VPS)

# Port aplikasi (Coolify: set "Ports Exposes" = 3000)
PORT=3000
# Folder data (database SQLite + PDF). Di Coolify mount volume ke /app/storage
STORAGE_DIR=./storage
# Rahasia cookie sesi login (ganti dengan string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang
# URL publik aplikasi (dipakai untuk redirect OAuth Shopee)
APP_URL=https://suite.glasspro.co.id

# Akun admin pertama (dibuat otomatis saat pertama kali jalan)
ADMIN_USER=admin
ADMIN_PASSWORD=glasspro123
ADMIN_NAME=Admin Glass Pro

# ===== Shopee Open Platform =====
SHOPEE_PARTNER_ID=2010826
SHOPEE_PARTNER_KEY=isi-partner-key-live
# live | test
SHOPEE_ENV=live
# Redirect URL harus di bawah domain yang terdaftar di Shopee (https://suite.glasspro.co.id/)
SHOPEE_REDIRECT_URL=https://suite.glasspro.co.id/api/shopee/callback
# direct  = panggil API Shopee langsung (dipakai di VPS yang IP-nya sudah di-whitelist)
# bridge  = lewat jembatan VPS (dipakai saat aplikasi jalan di laptop lokal)
# mock    = data simulasi untuk demo/testing tanpa Shopee
SHOPEE_TRANSPORT=direct
SHOPEE_BRIDGE_URL=https://suite.glasspro.co.id/bridge/shopee
SHOPEE_BRIDGE_TOKEN=

# Token yang harus dikirim client untuk memakai endpoint jembatan /bridge/shopee di VPS
BRIDGE_TOKEN=ganti-dengan-token-acak
